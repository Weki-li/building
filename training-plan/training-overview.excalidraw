"2026-09-30T00:08:38.686Z", "version": 1, "textAlign": "left"}, {"id": "z2-str-mod-1-b2", "type": "text", "x": 1594, "y": 776, "width": 153, "height": 21, "backgroundColor": "transparent", "strokeColor": "#0A0A0A", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "text": "单腿硬拉 15-30s × 3 组", "fontSize": 16, "fontFamily": 2, "fillStyle": "solid", "createdAt": "2026-09-30T00:08:38.686Z", "updatedAt": "2026-09-30T00:08:38.686Z", "version": 1, "textAlign": "left"}, {"id": "z2-str-mod-2", "type": "rectangle", "x": 1930, "y": 688, "width": 320, "height": 210, "backgroundColor": "#FFFFFF", "strokeColor": "#7373735C", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "roundness": {"type": 3, "value": 10}, "fillStyle": "solid", "createdAt": "2026-09-30T00:08:38.686Z", "updatedAt": "2026-09-30T00:08:38.686Z", "version": 1}, {"id": "z2-str-mod-2-title", "type": "text", "x": 1944, "y": 698, "width": 40, "height": 25, "backgroundColor": "transparent", "strokeColor": "#0A0A0A", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "text": "上肢", "fontSize": 16, "fontFamily": 2, "fillStyle": "solid", "createdAt": "2026-09-30T00:08:38.686Z", "updatedAt": "2026-09-30T00:08:38.686Z", "version": 1, "textAlign": "left"}, {"id": "z2-str-mod-2-b0", "type": "text", "x": 1944, "y": 732, "width": 162, "height": 21, "backgroundColor": "transparent", "strokeColor": "#0A0A0A", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "text": "俯卧撑保持 30-45s × 3 组", "fontSize": 16, "fontFamily": 2, "fillStyle": "solid", "createdAt": "2026-09-30T00:08:38.687Z", "updatedAt": "2026-09-30T00:08:38.687Z", "version": 1, "textAlign": "left"}, {"id": "z2-str-mod-2-b1", "type": "text", "x": 1944, "y": 754, "width": 162, "height": 21, "backgroundColor": "transparent", "strokeColor": "#0A0A0A", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "text": "臂屈伸保持 20-30s × 3 组", "fontSize": 16, "fontFamily": 2, "fillStyle": "solid", "createdAt": "2026-09-30T00:08:38.687Z", "updatedAt": "2026-09-30T00:08:38.687Z", "version": 1, "textAlign": "left"}, {"id": "z2-str-mod-2-b2", "type": "text", "x": 1944, "y": 776, "width": 171, "height": 21, "backgroundColor": "transparent", "strokeColor": "#0A0A0A", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "text": "推墙保持 15-20s × 3-5 组", "fontSize": 16, "fontFamily": 2, "fillStyle": "solid", "createdAt": "2026-09-30T00:08:38.687Z", "updatedAt": "2026-09-30T00:08:38.687Z", "version": 1, "textAlign": "left"}, {"id": "bot-title", "type": "text", "x": 60, "y": 1230, "width": 81, "height": 30, "backgroundColor": "transparent", "strokeColor": "#0A0A0A", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "text": "进阶路径与注意事项", "fontSize": 20, "fontFamily": 2, "fillStyle": "solid", "createdAt": "2026-09-30T00:08:38.687Z", "updatedAt": "2026-09-30T00:08:38.687Z", "version": 1, "textAlign": "left"}, {"id": "path-card", "type": "rectangle", "x": 60, "y": 1270, "width": 1080, "height": 150, "backgroundColor": "#FFFFFF", "strokeColor": "#7373735C", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "roundness": {"type": 3, "value": 12}, "fillStyle": "solid", "createdAt": "2026-09-30T00:08:38.687Z", "updatedAt": "2026-09-30T00:08:38.687Z", "version": 1}, {"id": "path-card-title", "type": "text", "x": 78, "y": 1282, "width": 40, "height": 25, "backgroundColor": "transparent", "strokeColor": "#0A0A0A", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "text": "进阶路径", "fontSize": 16, "fontFamily": 2, "fillStyle": "solid", "createdAt": "2026-09-30T00:08:38.687Z", "updatedAt": "2026-09-30T00:08:38.687Z", "version": 1, "textAlign": "left"}, {"id": "path-l0", "type": "text", "x": 78, "y": 1318, "width": 639, "height": 21, "backgroundColor": "transparent", "strokeColor": "#0A0A0A", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "text": "新手线 → 有基础线 转线标准：颠球连续 50+ ｜ 正手发球到位率 80%+ ｜ 平板支撑 60s / 靠墙静蹲 60s ｜ 挥拍一致性达标", "fontSize": 16, "fontFamily": 2, "fillStyle": "solid", "createdAt": "2026-09-30T00:08:38.687Z", "updatedAt": "2026-09-30T00:08:38.687Z", "version": 1, "textAlign": "left"}, {"id": "path-l1", "type": "text", "x": 78, "y": 1344, "width": 360, "height": 21, "backgroundColor": "transparent", "strokeColor": "#0A0A0A", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "text": "两条线水平接近后 → 转为共同训练 + 同伴对练模式；每两周评估并调整训练重点。", "fontSize": 16, "fontFamily": 2, "fillStyle": "solid", "createdAt": "2026-09-30T00:08:38.687Z", "updatedAt": "2026-09-30T00:08:38.687Z", "version": 1, "textAlign": "left"}, {"id": "note-card", "type": "rectangle", "x": 1200, "y": 1270, "width": 1080, "height": 150, "backgroundColor": "#FFFFFF", "strokeColor": "#7373735C", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "roundness": {"type": 3, "value": 12}, "fillStyle": "solid", "createdAt": "2026-09-30T00:08:38.687Z", "updatedAt": "2026-09-30T00:08:38.687Z", "version": 1}, {"id": "note-card-title", "type": "text", "x": 1218, "y": 1282, "width": 40, "height": 25, "backgroundColor": "transparent", "strokeColor": "#0A0A0A", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "text": "注意事项", "fontSize": 16, "fontFamily": 2, "fillStyle": "solid", "createdAt": "2026-09-30T00:08:38.687Z", "updatedAt": "2026-09-30T00:08:38.687Z", "version": 1, "textAlign": "left"}, {"id": "note-l0", "type": "text", "x": 1218, "y": 1318, "width": 225, "height": 21, "backgroundColor": "transparent", "strokeColor": "#0A0A0A", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "text": "每次训练前热身 10-15 分钟，训练后拉伸放松。", "fontSize": 16, "fontFamily": 2, "fillStyle": "solid", "createdAt": "2026-09-30T00:08:38.687Z", "updatedAt": "2026-09-30T00:08:38.687Z", "version": 1, "textAlign": "left"}, {"id": "note-l1", "type": "text", "x": 1218, "y": 1342, "width": 207, "height": 21, "backgroundColor": "transparent", "strokeColor": "#0A0A0A", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "text": "等长训练保持正常呼吸不憋气；关节疼痛立即停止。", "fontSize": 16, "fontFamily": 2, "fillStyle": "solid", "createdAt": "2026-09-30T00:08:38.687Z", "updatedAt": "2026-09-30T00:08:38.687Z", "version": 1, "textAlign": "left"}, {"id": "note-l2", "type": "text", "x": 1218, "y": 1366, "width": 198, "height": 21, "backgroundColor": "transparent", "strokeColor": "#0A0A0A", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "text": "等长训练会使血压短暂升高，高血压人群需谨慎。", "fontSize": 16, "fontFamily": 2, "fillStyle": "solid", "createdAt": "2026-09-30T00:08:38.687Z", "updatedAt": "2026-09-30T00:08:38.687Z", "version": 1, "textAlign": "left"}, {"id": "note-l3", "type": "text", "x": 1218, "y": 1390, "width": 198, "height": 21, "backgroundColor": "transparent", "strokeColor": "#0A0A0A", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "text": "技术训练优先动作质量，不盲目追求次数与球速。", "fontSize": 16, "fontFamily": 2, "fillStyle": "solid", "createdAt": "2026-09-30T00:08:38.687Z", "updatedAt": "2026-09-30T00:08:38.687Z", "version": 1, "textAlign": "left"}], "appState": {"viewBackgroundColor": "#F7F6F5", "gridSize": null}}